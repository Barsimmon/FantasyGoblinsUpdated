<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FantasyGoblinsUpdated</AssemblyName>
    <RootNamespace>FantasyGoblinsUpdated</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS0618;CS8632</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../../../Assemblies/</OutputPath>
    <DebugType>none</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Override on the command line if your paths differ, e.g.
      dotnet build -c Release -p:GameManagedDir=/path/to/Managed -p:HarmonyDll=/path/to/0Harmony.dll
    RimWorld root is 6 levels above this project folder (.../common/RimWorld).
  -->
  <PropertyGroup>
    <RimWorldDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../../../../'))</RimWorldDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == '' And Exists('$(RimWorldDir)RimWorldLinux_Data/Managed')">$(RimWorldDir)RimWorldLinux_Data/Managed</GameManagedDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == '' And Exists('$(RimWorldDir)RimWorldWin64_Data/Managed')">$(RimWorldDir)RimWorldWin64_Data/Managed</GameManagedDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(RimWorldDir)Managed</GameManagedDir>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">$(RimWorldDir)../../workshop/content/294100/2009463077/1.6/Assemblies/0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(GameManagedDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(GameManagedDir)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
